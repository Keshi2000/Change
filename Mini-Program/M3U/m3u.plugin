#!name = 体育直播源提取
#!desc = 提取咪咕、腾讯、百视通源地址
#!author = Keshi

[Script]
# 1. 咪咕 FLV (HTTP)
http-request ^http:\/\/.*(miguvideo\.com|migu\.cn).*\.flv script-path=https://raw.githubusercontent.com/Keshi2000/Change/refs/heads/main/Mini-Program/M3U/m3u.js, requires-body=false, tag=抓取咪咕FLV

# 2. 咪咕 M3U8 (HTTP)
http-request ^http:\/\/.*(miguvideo\.com|migu\.cn).*\.m3u8.* script-path=https://raw.githubusercontent.com/Keshi2000/Change/refs/heads/main/Mini-Program/M3U/m3u.js, requires-body=false, tag=抓取咪咕M3U8

# 3. 腾讯体育 M3U8 (HTTPS)
http-request ^https?:\/\/.*smtcdns.*video\.qq\.com.*\.m3u8.* script-path=https://raw.githubusercontent.com/Keshi2000/Change/refs/heads/main/Mini-Program/M3U/m3u.js, requires-body=false, tag=抓取腾讯_M3U8

# 4. 百视通 M3U8 (HTTPS)
http-request ^https?:\/\/.*\.bestv\.cn\/.*\.m3u8.* script-path=https://raw.githubusercontent.com/Keshi2000/Change/refs/heads/main/Mini-Program/M3U/m3u.js, requires-body=false, tag=抓取百视通_M3U8

[MITM]
# 去掉了 Jrkan 的域名
hostname = *.smtcdns.net, video.qq.com, *.bestv.cn